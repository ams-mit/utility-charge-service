# utility-charge-service — Environment Variables
# Copy this to .env and fill in actual values.
# NEVER commit .env to version control.

# Database
DB_URL=jdbc:mysql://localhost:3306/utility_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=ams_user
DB_PASSWORD=your_password_here

# JWT — must match the secret used by Group 1 identity-access-service
JWT_SECRET=shared-secret-key-agreed-with-group1-minimum-256-bits

# Service URLs
BILLING_SERVICE_URL=http://billing-payment-service:8081

# Server
SERVER_PORT=8082