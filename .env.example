# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=utility-charge-service
SERVER_PORT=8082

# ── Database ─────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/utility_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=password

# ── JWT — RS256 Keys ─────────────────────────────────────────
# Gateway public key — used to verify ALL incoming Gateway JWTs
GATEWAY_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----<gateway-public-key>-----END PUBLIC KEY-----

# This service's RSA private key — used to sign outgoing Service JWTs
SERVICE_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----<service-private-key>-----END PRIVATE KEY-----

# Service JWT expiry — 5 minutes per v2.1 spec
SERVICE_JWT_EXPIRES_IN=5m

# ── Inter-service Communication ───────────────────────────────────────────────
# Per v2.1: ALL inter-service calls go through the API Gateway
# Services never call each other directly
API_GATEWAY_URL=http://localhost:8080

# ── Frontend CORS ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
